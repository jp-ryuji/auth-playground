# Local defaults. Copy to .env if you want. Do not export this whole file into
# one shell: apps/api and apps/oauth-login both read PORT.
#
# apps/api (this process uses PORT=8080)
HYDRA_ISSUER=http://127.0.0.1:4444/
CLIENT_ID=auth-playground-rp
REDIRECT_URI=http://127.0.0.1:8080/auth/callback
SCOPES=openid offline
PORT=8080
AUTH_STATE_TTL=10m
SECURE_COOKIE=false
DISCOVERY_TIMEOUT=10s

# apps/oauth-login (run in a second shell with PORT=3000)
HYDRA_ADMIN_URL=http://127.0.0.1:4445
KRATOS_PUBLIC_URL=http://127.0.0.1:4433
OAUTH_LOGIN_BASE_URL=http://127.0.0.1:3000

# Dev clients created by `make ready` / scripts/seed-clients.sh.
# apps/api does not read these secrets until code exchange, M2M, and token
# exchange are implemented. Values are local placeholders.
CLIENT_SECRET=dev-only-interactive-rp-secret
OAUTH_M2M_CLIENT_ID=auth-playground-m2m
OAUTH_M2M_SECRET=dev-only-m2m-secret
OAUTH_EXCHANGE_CLIENT_ID=auth-playground-exchange
OAUTH_EXCHANGE_SECRET=dev-only-exchange-secret
